# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Backend Server Port (Default is 5000 for local standalone backend, 3000 in full-stack container)
PORT=5000

# Twilio SMS Credentials for Real Phone OTP Delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Twilio Verify Service SID (auto-provisioned or configured in Twilio Console)
TWILIO_VERIFY_SERVICE_SID=

# Google Maps / Places API Key for live nearby doctors, clinics, and hospitals search
GOOGLE_MAPS_API_KEY=

# Frontend configuration (Optional: if frontend at http://localhost:5173 calls backend directly)
VITE_API_BASE_URL=http://localhost:5000
