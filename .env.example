# ===================================================================
# MedMitra Environment Variables
# ===================================================================

# -------------------------------------------------------------------
# 1. REAL MOBILE OTP SMS PROVIDER (Backend Only)
# -------------------------------------------------------------------
# Provide Twilio credentials OR Fast2SMS credentials to deliver real SMS OTPs.
# The backend generates the OTP securely, sends via SMS, and verifies on backend.
# OTP is NEVER exposed to the frontend, browser console, logs, or API responses.

# Option A: Twilio SMS (Global / India)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional: Twilio Verify Service SID (if using Twilio Verify API)
TWILIO_VERIFY_SERVICE_SID=

# Option B: Fast2SMS Quick OTP API (India SMS)
FAST2SMS_API_KEY=

# -------------------------------------------------------------------
# 2. GOOGLE MAPS / PLACES API (Nearby Doctors & Hospitals)
# -------------------------------------------------------------------
# Required for live nearby verified doctor, clinic, and hospital searches.
# Never expose this key in frontend code; queries are proxied via backend.
# If this key is missing, MedMitra clearly displays a configuration notice
# and strictly does NOT display fake or fabricated doctor/hospital locations.
GOOGLE_MAPS_API_KEY=

# -------------------------------------------------------------------
# 3. KAGGLE MEDICAL / MEDICINE DATASET (Backend Only)
# -------------------------------------------------------------------
# MedMitra is connected to the authentic Kaggle Indian Medicine Dataset:
# "shubhambathwal/medicine-dataset" (Uses, Indications & Basic Pharma Info).
# Optional Kaggle API credentials for live dataset syncing:
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=shubhambathwal/medicine-dataset

# -------------------------------------------------------------------
# 4. GEMINI AI (Conversational Intelligence & Symptom Analysis)
# -------------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------------
# 5. SERVER CONFIGURATION
# -------------------------------------------------------------------
# Port 5000 for local standalone backend, port 3000 in Cloud Run container
PORT=5000
APP_URL=
VITE_API_BASE_URL=http://localhost:5000
